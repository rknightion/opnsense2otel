[Unit]
Description=Daily backstop shutdown of the OPNsense testbed

[Timer]
# 08:30 UTC. STAYS ENABLED although the up and canary timers are disabled: the
# lab is now raised on demand, and this is what takes it down if a session
# forgets to. The down is skipped entirely while a hold is active, so on-demand
# work that took a hold is never fighting this.
OnCalendar=*-*-* 08:30:00 UTC
# TRUE here, unlike the up timer. All six guests are onboot:0, so an oli reboot
# leaves them down and this is normally a no-op — it is kept as the backstop for
# the case that actually costs money: a hold, a manual `up`, or a failed earlier
# down leaving the lab running while oli happens to reboot past 08:30.
# It is safe to fire spuriously because down is idempotent on a stopped guest.
Persistent=true

[Install]
WantedBy=timers.target
