{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "name": "opnsense-dhcp6-clients-stuck-in-solicit",
    "annotations": {
      "grafana.app/folder": "opnsense2otel-alerts"
    },
    "labels": {
      "grafana.app/folder": "opnsense2otel-alerts"
    }
  },
  "spec": {
    "title": "OPNsenseDHCP6ClientsStuckInSolicit",
    "noDataState": "Ok",
    "execErrState": "Error",
    "for": "30m0s",
    "trigger": {
      "interval": "1m"
    },
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "summary": "OPNsense DHCPv6 clients are stuck in SOLICIT and have no address ({{ $labels.opnsense_instance }})",
      "description": "At least one DHCPv6 client has been retransmitting the same SOLICIT for over 30m: kea advertised it an address, kea advertised the same transaction again 10 minutes or more later, and the client has never sent the REQUEST that would take the address. Nothing is refused, so OPNsenseDHCP6AllocationFailures cannot see this. The usual cause is that the router cannot resolve the client's new link-local address by neighbour discovery, so the unicast ADVERTISE is dropped and the client sits with no IPv6 address.",
      "runbook_url": "https://github.com/rknightion/opnsense2otel/blob/main/grafana/runbooks.md#opnsensedhcp6clientsstuckinsolicit",
      "__dashboardUid__": "opnsense-exporter",
      "__panelId__": "337"
    },
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": "15m0s",
          "to": "0s"
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "max by (opnsense_instance) (opnsense_log_events_dhcp6_solicit_stuck_clients)",
          "instant": true,
          "range": false,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      "C": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "type": "threshold",
          "refId": "C",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0,
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ]
        },
        "source": true
      }
    }
  }
}
